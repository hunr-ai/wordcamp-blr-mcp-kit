{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_ENVIRONMENT_TYPE": "local"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "mcp-adapter/mcp-adapter.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require '/demo/seed.php';"
		}
	]
}
